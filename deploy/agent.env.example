# FIRST-PARTY CONFIGURATION TEMPLATE — NEVER put real values in this file or Git.
# Installed as a private 0600 file on the host, mounted into the container.
# The executable explicitly requires BOTH channels; missing credentials fail
# startup rather than silently dropping a platform.
CLOUD_AGENT_CHANNELS=feishu,wecom
CLOUD_AGENT_STATE_DIR=/var/lib/cloud-pi/state
RESEARCH_RUNS_DIR=/var/lib/cloud-pi/runs
CLOUD_AGENT_API_HOST=127.0.0.1
CLOUD_AGENT_API_PORT=8787

# Host networking makes existing host-local New API reachable via 127.0.0.1.
CLOUD_PI_MODEL_BASE_URL=http://127.0.0.1:3000/v1
CLOUD_PI_MODEL_ID=
CLOUD_PI_MODEL_API_KEY=
CLOUD_PI_RUN_TIMEOUT_MS=120000

# Obtain these only from the respective official bots. Never paste into tickets.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_CHAT_IDS=
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# Guanlan is a separate Cloudflare Worker. Do not put a five-minute JWT in
# this long-running env file. Use the broker's rotate-on-demand token file.
# GUANLAN_MCP_URL=https://your-verified-worker.example/mcp
# GUANLAN_MCP_TOKEN_FILE=/var/lib/cloud-pi/guanlan-access.jwt
# GUANLAN_MCP_ALLOW_WRITE=false
