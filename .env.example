# Cloud Pi live Agent — model configuration
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Required
CLOUD_PI_MODEL_BASE_URL=
CLOUD_PI_MODEL_API_KEY=
CLOUD_PI_MODEL_ID=

# Optional — defaults shown
# CLOUD_PI_MODEL_API=openai-completions
# CLOUD_PI_MODEL_PROVIDER_ID=cloud-pi-live
# CLOUD_PI_MODEL_CONTEXT_WINDOW=131072
# CLOUD_PI_MODEL_MAX_OUTPUT_TOKENS=4096
# CLOUD_PI_RUN_TIMEOUT_MS=120000
# CLOUD_PI_MAX_TOOL_CALLS=8

# Read-only directory exposed to the local_read_text tool (default: ./notes)
# CLOUD_PI_TOOL_ROOT=./notes

# Feishu channel (AGT-029). Never commit an app secret.
#
# These are NOT normally stored in this file: inject them into the channel
# process only, for example:
#   FEISHU_APP_ID=cli_... FEISHU_APP_SECRET=... npm run channel:feishu
#
# The app must have bot capability, the `im.message.receive_v1` event delivered
# over the long-connection (WebSocket) mode, and permission to send messages.
# FEISHU_ALLOWED_CHAT_IDS is the local trusted POC allowlist for group chats;
# leave it empty to allow private chat only.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_ALLOWED_CHAT_IDS=
# Optional: skip the /open-apis/bot/v3/info lookup, or select lark domain.
# FEISHU_BOT_OPEN_ID=
# FEISHU_DOMAIN=feishu

# WeCom 智能机器人 channel (AGT-036). Never commit a bot secret.
#
# Inject the credentials into the channel process only, for example:
#   WECOM_BOT_ID=... WECOM_BOT_SECRET=... npm run channel:wecom
#
# The bot must be created in the WeCom admin console in API mode with the
# long-connection (WebSocket) transport; the platform allows one connection per
# bot, so only one channel process may run. WECOM_BOT_NAME is the bot's display
# name and is required for group chats: a group message is only accepted when its
# text starts with `@<that name>` (WeCom delivers no structured mention).
# WECOM_ALLOWED_* are local channel allowlists, not Cloud Auth authorization.
# WECOM_BOT_ID=
# WECOM_BOT_SECRET=
# WECOM_BOT_NAME=
# WECOM_ALLOWED_USER_IDS=
# WECOM_ALLOWED_CHAT_IDS=
# Optional — leave WECOM_WS_URL unset to use the official SDK's default endpoint.
# WECOM_WS_URL=
# WECOM_HEARTBEAT_INTERVAL_MS=30000
# WECOM_CONNECT_TIMEOUT_MS=20000
# WECOM_REPLY_MAX_BYTES=20000
# WECOM_REPLY_TIMEOUT_MS=15000

# Unified Cloud Agent entry (AGT-037). `npm run start` reads this file when it
# exists; every value has a default and none of them is a credential.
#
# CLOUD_AGENT_CHANNELS = auto | none | feishu | wecom | feishu,wecom
#   auto   enable exactly the channels whose credentials are present (default)
#   none   scheduler + delivery + management API only
#   a list requires those channels and exits 2 when a credential is missing
# CLOUD_AGENT_CHANNELS=auto
# CLOUD_AGENT_STATE_DIR=.work/cloud-agent
# RESEARCH_RUNS_DIR=.work/research-runs
# CLOUD_AGENT_API_HOST=127.0.0.1
# CLOUD_AGENT_API_PORT=8787
# CLOUD_AGENT_TICK_INTERVAL_MS=30000
# CLOUD_AGENT_SHUTDOWN_TIMEOUT_MS=20000
#
# WeCom credential file used by `npm run start` (default ~/.mira-secrets/wecom.env).
# It is read into the process environment only; values are never logged or written.
# CLOUD_AGENT_WECOM_SECRETS=

